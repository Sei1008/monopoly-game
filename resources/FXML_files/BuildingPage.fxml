<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="220" prefWidth="500" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="FXML_Controllers.BuildingPage">
    <children>
        <ImageView fitHeight="220" fitWidth="500" layoutX="0" layoutY="0" pickOnBounds="true" preserveRatio="false">
            <image><Image url="@../images/backgroundPopUp.png" /></image>
        </ImageView>
        <Label fx:id="PopUp_Label" layoutX="50" layoutY="20" prefHeight="50" prefWidth="400" textAlignment="CENTER">
            <font><Font name="Berlin Sans FB" size="20" /></font>
        </Label>
        <Button fx:id="Button_House" layoutX="120" layoutY="120" prefHeight="35" prefWidth="100" text="House $150" textFill="BLACK"
                onMouseClicked="#Click_On_House">
            <style>-fx-background-color: #f6ff00;</style>
            <font><Font name="Berlin Sans FB Demi Bold" size="16" /></font>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
        <Button fx:id="Button_Hotel" layoutX="280" layoutY="120" prefHeight="35" prefWidth="100" text="Hotel $250" textFill="BLACK"
                onMouseClicked="#Click_On_Hotel">
            <style>-fx-background-color: #f6ff00;</style>
            <font><Font name="Berlin Sans FB Demi Bold" size="16" /></font>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
        <Button fx:id="Button_Cancel" layoutX="200" layoutY="170" prefHeight="30" prefWidth="100" text="Cancel" textFill="WHITE"
                onMouseClicked="#Click_On_Cancel">
            <style>-fx-background-color: #ff4444;</style>
            <font><Font name="Berlin Sans FB Demi Bold" size="16" /></font>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
    </children>
</AnchorPane>

